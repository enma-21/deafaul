# Credenciales OAuth de la app de Mercado Libre usada para autorizar
# la cuenta de Masterbrake1937 (creada desde una cuenta de otro país,
# ya que DevCenter no está disponible para cuentas de Venezuela).
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Tokens obtenidos tras el flujo de autorización OAuth de la cuenta
# vendedora Masterbrake1937. El access_token expira a las 6 horas;
# usa refresh_token.py para renovarlo con el refresh_token.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
